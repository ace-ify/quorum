# The House Imposter: AI Reality Show - Environment Variables

# LLM Configuration
# Choose "gemini" or "openai_compatible"
LLM_PROVIDER=gemini

# If using Gemini directly:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# If using FreeLLMAPI or any OpenAI-compatible endpoint:
# OPENAI_API_KEY=your_freellmapi_or_openai_key
# OPENAI_BASE_URL=https://api.freellmapi.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Switch Server Configuration
SWITCH_GATEWAY_URL=http://localhost:8080
SWITCH_WS_URL=ws://localhost:8080
SWITCH_WORKSPACE_ID=the-house-season-1

# Discord Configuration (managed through Switch Console or Bot Token)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_discord_guild_id_here

# Game Pacing Options
FAST_TIMERS=true
DEBUG_LOGS=true

